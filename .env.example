# Copy this file to .env (at the repo root) before running `docker compose up`.
# docker-compose.yml reads these to configure the db/backend containers.
# This is SEPARATE from backend/.env and ml-service/.env, which are used for
# the non-Docker local setup described in backend/README.md - Docker Compose
# does not read those.

# PostgreSQL password (used by both the db container and the backend container
# to connect to it) - pick a real value, don't leave this as-is.
DB_PASSWORD=change_me

# Secret used to sign login session tokens (JWT). Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_long_random_secret
