# Copy this file to .env and fill in real values. .env itself is gitignored.

# Server
PORT=5000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=weddinglens
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Secret used to sign login session tokens (JWT). Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_long_random_secret

# Path to the Python interpreter INSIDE ml-service/venv (used to run
# ml-service/scripts/09_predict.py for style prediction). On Windows this is
# typically ml-service/venv/Scripts/python.exe
PYTHON_PATH=../ml-service/venv/Scripts/python.exe

# Absolute or relative path to the prediction script
PREDICT_SCRIPT_PATH=../ml-service/scripts/09_predict.py

# Max upload size in bytes (default 5MB)
MAX_UPLOAD_BYTES=5242880
